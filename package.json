{
  "name": "vitempl-monorepo",
  "private": true,
  "license": "MIT",
  "author": "Stepan Sotnikov",
  "description": "Template engine with Vite",
  "homepage": "https://github.com/sotnikovse/vitempl#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sotnikovse/vitempl.git"
  },
  "bugs": {
    "url": "https://github.com/sotnikovse/vitempl/issues"
  },
  "keywords": [
    "vite",
    "template",
    "engine",
    "frontend",
    "dev-server",
    "build-tool"
  ],
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "playground/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages --if-present",
    "test": "npm run test --workspace=packages --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "release": "node scripts/release.ts",
    "format": "prettier --ignore-unknown --list-different --write .",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "example:build": "npm run build --workspace=node-template-hbs",
    "example:start": "npm run start --workspace=node-app"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@vitejs/release-scripts": "^1.10.0",
    "execa": "^10.0.1",
    "picocolors": "^1.1.1",
    "prettier": "^3.9.8",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-inspect": "^12.0.2",
    "vitepress": "^2.0.0-alpha.20",
    "vitest": "^5.0.1"
  }
}
